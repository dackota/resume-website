# Full nginx config (replaces the image default) tuned for running under
# generic-app-chart's restricted pod security defaults: arbitrary non-root
# uid, readOnlyRootFilesystem, and a writable emptyDir at /tmp only — so the
# pid file and every temp path live under /tmp, and logs go to stdout/stderr.
# Same shape as consulting-spa's config.
#
# This is an envsubst template, not a finished config: the base image's
# entrypoint renders it to /tmp/nginx.conf at container start so the Honeycomb
# ingest key can arrive as an env var instead of being baked into the image.
# Only ${HONEYCOMB_*} is substituted (NGINX_ENVSUBST_FILTER in the Dockerfile) —
# nginx's own $uri, $args, $http_* survive untouched. See the /v1/traces block.
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;

  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;
  server_tokens off;

  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  gzip on;
  gzip_min_length 512;
  gzip_types text/css application/javascript image/svg+xml application/json;

  server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'" always;

    # Same-origin proxy to the change-tracking dashboard's read-only JSON API
    # (github.com/dackota/change-tracking-dashboard). It sends no CORS headers,
    # so the browser can't call it cross-origin — proxying here keeps the page's
    # CSP at connect-src 'self' instead of allow-listing another host.
    #
    # The upstream host goes through a variable on purpose: with a literal,
    # nginx resolves at startup and a DNS blip would crashloop the whole site.
    # Via a variable it resolves per request, so a resolution failure is a 502
    # on one section instead of an outage. A variable in proxy_pass requires an
    # explicit resolver — `local=on` (read /etc/resolv.conf) is rejected by
    # nginx 1.31.3, so the public resolvers are named here. To move this
    # in-cluster later, point $changes_host at the Service DNS name and swap
    # these for the kube-dns ClusterIP.
    resolver 1.1.1.1 9.9.9.9 ipv6=off valid=60s;
    resolver_timeout 3s;

    location ~ ^/api/changes/(?<changes_path>.*)$ {
      set $changes_host "changes.dackota.com";
      proxy_pass https://$changes_host/api/$changes_path$is_args$args;

      proxy_ssl_server_name on;
      proxy_ssl_verify on;
      proxy_ssl_verify_depth 3;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

      proxy_set_header Host $changes_host;
      proxy_pass_request_headers off;

      # The detail routes content-negotiate on Accept: naming application/json
      # gets JSON, anything else gets an HTML fragment. Both representations are
      # needed (the fragment carries the chart/terraform path the JSON omits),
      # so the client's Accept is forwarded rather than pinned here.
      proxy_set_header Accept $http_accept;

      # Its security headers are written for its own HTML pages; ours govern this one.
      proxy_hide_header Content-Security-Policy;
      proxy_hide_header X-Frame-Options;
      proxy_hide_header Referrer-Policy;
      proxy_hide_header X-Content-Type-Options;

      proxy_connect_timeout 5s;
      proxy_send_timeout 5s;
      proxy_read_timeout 10s;

      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
    }

    # OTLP/HTTP trace ingest. app.js POSTs its spans same-origin to /v1/traces
    # and this forwards them to Honeycomb with the ingest key attached *here* —
    # so the key never ships in client JS, and the page's CSP stays at
    # connect-src 'self' instead of allow-listing api.honeycomb.io. It also
    # means the unload flush can use sendBeacon, which cannot set headers.
    location = /v1/traces {
      set $honeycomb_key "${HONEYCOMB_API_KEY}";
      set $honeycomb_host "api.honeycomb.io";

      # No key configured — local `docker run`, CI, anyone building this repo
      # without a Honeycomb account. Swallow the beacon so the page behaves
      # identically instead of logging a wall of 502s.
      if ($honeycomb_key = "") { return 204; }
      if ($request_method != POST) { return 405; }

      # A span batch is a few KB; this is an anti-abuse cap, not a tuning knob.
      client_max_body_size 512k;

      proxy_pass https://$honeycomb_host/v1/traces;

      proxy_ssl_server_name on;
      proxy_ssl_verify on;
      proxy_ssl_verify_depth 3;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

      # Nothing the browser sent is forwarded: the client has no say in the
      # auth header, and its Origin/Referer/Cookie have no business upstream.
      proxy_pass_request_headers off;
      proxy_set_header Host $honeycomb_host;
      proxy_set_header Content-Type "application/json";
      proxy_set_header x-honeycomb-team $honeycomb_key;

      proxy_connect_timeout 5s;
      proxy_send_timeout 5s;
      proxy_read_timeout 10s;

      # One line per span batch per visitor would drown the real access log.
      access_log off;
      add_header Cache-Control "no-store" always;
    }

    # Probe endpoint for the chart's liveness/readiness checks.
    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

    # Static assets are cached hard, which is only safe because index.html
    # references them with ?v=<release version> (substituted at image build —
    # see Dockerfile). A release changes the URL, so returning visitors fetch
    # the new asset immediately instead of running stale JS against new HTML.
    # `expires` is deliberately not used here: it emits its own Cache-Control
    # and would duplicate the header.
    location /assets/ {
      add_header Cache-Control "public, max-age=604800, immutable" always;
      add_header X-Content-Type-Options "nosniff" always;
      try_files $uri =404;
    }

    # The RSS feed. mime.types maps .xml to text/xml — feed readers tolerate it,
    # but application/rss+xml is the registered type. An exact-match location is
    # used rather than a `types { }` override inside location /blog/, because a
    # types block *replaces* the entire MIME table for its context: post images
    # in page bundles would have been served as the default type instead of
    # image/png. Exact matches win over prefix matches, so this needs no
    # ordering relative to the block below.
    #
    # /blog/sitemap.xml deliberately keeps the default type — it is not RSS.
    location = /blog/index.xml {
      # A types block replaces the whole MIME table for its context, which is
      # harmless only because this location serves exactly one file. default_type
      # would not work here: it applies when no extension mapping matched, and
      # mime.types already maps .xml to text/xml.
      types { application/rss+xml xml; }
      add_header Cache-Control "no-cache" always;
      add_header X-Content-Type-Options "nosniff" always;
      try_files $uri =404;
    }

    # The blog (Hugo-generated at image build; see Dockerfile). This block must
    # come before the catch-all below, and its whole purpose is to opt out of
    # the SPA fallback: without it, /blog/mistyped-slug would serve the resume
    # page with a 200 — invisible to a reader, and wrong for a crawler, which
    # would index the resume under a dozen phantom post URLs.
    #
    # Posts are directory-per-slug (/blog/my-post/index.html), so $uri/index.html
    # resolves pretty URLs and anything genuinely missing falls to =404, which
    # error_page then renders as Hugo's styled 404 with a real 404 status.
    #
    # no-cache, not immutable: blog HTML is the same category as index.html — it
    # has to change the moment a post ships. Only /assets/ is cached hard.
    location /blog/ {
      add_header Cache-Control "no-cache" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'" always;

      # The headers above are restated rather than inherited: add_header
      # inheritance is all-or-nothing per block, and declaring any header here
      # drops every one declared at server level. Same trap the catch-all below
      # already works around.

      try_files $uri $uri/index.html =404;
      error_page 404 /blog/404.html;
    }

    # SPA fallback: any unknown path serves the app shell.
    location / {
      add_header Cache-Control "no-cache" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'" always;
      try_files $uri $uri/ /index.html;
    }
  }
}
